{
  "name": "@clipvault/desktop-agent",
  "version": "1.0.0",
  "description": "Windows 10/11 Native Clipboard Capture Agent for ClipVault",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node copy-assets.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clipvault/shared": "*"
  }
}
