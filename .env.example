# ClipVault Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!

NODE_ENV=development
CLIPVAULT_PORT=4000
CLIPVAULT_LOCAL_DB_PATH=./data/vault.sqlite

# Supabase Platform Configuration (Required for Cross-Device Sync)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key should only be used in secure backend migrations or seed scripts
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Desktop Agent Configuration
CLIPVAULT_AUTOSTART=true
CLIPVAULT_POLL_INTERVAL_MS=0 # Zero means event-driven Win32 hooks only
